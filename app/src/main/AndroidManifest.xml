<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/sleeptracklogo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/sleeptracklogo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SLEEPTRACKAPP"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- HU-01: Conocer SleepTrack -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HU-02: Crear perfil -->
        <activity
            android:name=".CrearPerfilActivity"
            android:exported="false" />

        <!-- HU-03: Iniciar sesión -->
        <activity
            android:name=".IniciarSesionActivity"
            android:exported="false" />

        <!-- HU-05: Aceptar sensores y almacenamiento local -->
        <activity
            android:name=".ConsentimientoActivity"
            android:exported="false" />

        <!-- HU-06: Configurar el descanso y el monitoreo -->
        <activity
            android:name=".ConfigurarDescansoActivity"
            android:exported="false" />

        <!-- HU-07 y HU-08: Iniciar, Consultar y finalizar el monitoreo -->
        <activity
            android:name=".MonitoreoActivity"
            android:exported="false" />

        <!-- HU-09, HU-10 y HU-11: Registro Diario -->
        <activity
            android:name=".RegistroDiarioActivity"
            android:exported="false" />

        <!-- HU-12, HU-13 y HU-14: Resumen del descanso -->
        <activity
            android:name=".ResumenDescansoActivity"
            android:exported="false" />

        <!-- HU-15 y HU-16: Análisis semanal -->
        <activity
            android:name=".AnalisisSemanalActivity"
            android:exported="false" />

        <!-- HU-17 y HU-18: Historial mensual -->
        <activity
            android:name=".HistorialMensualActivity"
            android:exported="false" />

        <!-- HU-19 y HU-20: Recomendaciones, alertas y logros -->
        <activity
            android:name=".RecomendacionesActivity"
            android:exported="false" />

        <!-- HU-21 y HU-22: Perfil, cuenta y cerrar sesión -->
        <activity
            android:name=".PerfilCuentaActivity"
            android:exported="false" />

        <!-- HU-23: Gestionar privacidad y eliminar registros -->
        <activity
            android:name=".PrivacidadDatosActivity"
            android:exported="false" />
    </application>

</manifest>