    <string name="hu20_alerta_preventiva">Alerta preventiva</string>
    <string name="hu20_alerta_desc">Has dormido por debajo de tu meta personal durante 3 noches consecutivas.</string>

    <string name="hu20_logro_semana">Logro de la semana</string>
    <string name="hu20_logro_desc">Cumpliste tu meta de sueño 3 veces esta semana</string>

