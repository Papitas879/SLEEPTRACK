    <string name="hu20_rec1_titulo">Reduce el uso del smartphone</string>
    <string name="hu20_rec1_desc">Intenta dejar el celular 45 minutos antes de tu hora objetivo para dormir.</string>
    <string name="hu20_rec1_tag">Pantallas</string>

    <string name="hu20_rec2_titulo">Mantén horarios más constantes</string>
    <string name="hu20_rec2_desc">Intenta acostarte y levantarte a la misma hora, incluyendo fines de semana.</string>
    <string name="hu20_rec2_tag">Horarios</string>

    <string name="hu20_rec3_titulo">Controla el consumo de cafeína</string>
    <string name="hu20_rec3_desc">Evita bebidas energizantes o café dentro de las 6 horas antes de dormir.</string>
    <string name="hu20_rec3_tag">Cafeína</string>

    <string name="hu20_rec4_titulo">Finaliza tareas digitales antes</string>
    <string name="hu20_rec4_desc">Considera terminar tus proyectos de programación y estudios al menos 1 hora antes de tu rutina nocturna.</string>
    <string name="hu20_rec4_tag">Pantallas</string>

    <string name="hu20_rec5_titulo">Planifica tus tareas académicas</string>
    <string name="hu20_rec5_desc">Organiza las entregas pendientes para evitar el estrés nocturno antes de exámenes.</string>
    <string name="hu20_rec5_tag">Estrés</string>

    <string name="hu20_rec6_titulo">Regula la temperatura</string>
    <string name="hu20_rec6_desc">Mantén tu habitación fresca, idealmente entre 18°C y 20°C para un descanso óptimo.</string>
    <string name="hu20_rec6_tag">Ambiente</string>

    <string name="hu20_rec7_titulo">Oscurece tu habitación</string>
    <string name="hu20_rec7_desc">Usa cortinas blackout o un antifaz. La oscuridad total estimula la producción de melatonina.</string>
    <string name="hu20_rec7_tag">Ambiente</string>

    <string name="hu20_rec8_titulo">Haz ejercicio regular</string>
    <string name="hu20_rec8_desc">30 minutos de actividad física al día te ayudarán a dormir más profundo, pero evítalo justo antes de acostarte.</string>
    <string name="hu20_rec8_tag">Hábitos</string>

    <string name="hu20_rec9_titulo">Cenas ligeras</string>
    <string name="hu20_rec9_desc">Evita comidas pesadas o picantes 2-3 horas antes de dormir para prevenir indigestión.</string>
    <string name="hu20_rec9_tag">Hábitos</string>

    <string name="hu20_rec10_titulo">Practica la respiración</string>
    <string name="hu20_rec10_desc">Usa técnicas como la respiración 4-7-8 para relajar tu sistema nervioso y prepararlo para dormir.</string>
    <string name="hu20_rec10_tag">Estrés</string>

    <string name="hu20_rec11_titulo">Establece un ritual nocturno</string>
    <string name="hu20_rec11_desc">Dedica los últimos 30 minutos a una actividad relajante como leer o escuchar música suave.</string>
    <string name="hu20_rec11_tag">Hábitos</string>

    <string name="hu20_rec12_titulo">Evita trabajar en la cama</string>
    <string name="hu20_rec12_desc">Reserva la cama únicamente para dormir y descansar, tu cerebro asociará el lugar con el sueño.</string>
    <string name="hu20_rec12_tag">Ambiente</string>

    <string name="hu20_rec13_titulo">Hidrátate con moderación</string>
    <string name="hu20_rec13_desc">Bebe suficiente agua en el día, pero reduce el consumo en la noche para evitar interrupciones.</string>
    <string name="hu20_rec13_tag">Hábitos</string>

    <string name="hu20_rec14_titulo">Maneja las preocupaciones</string>
    <string name="hu20_rec14_desc">Si tienes muchas cosas en mente, anótalas en una libreta antes de acostarte para liberar tu mente.</string>
    <string name="hu20_rec14_tag">Estrés</string>

    <string name="hu20_rec15_titulo">Luz natural matutina</string>
    <string name="hu20_rec15_desc">Exponte a la luz del sol poco después de despertar para regular tu reloj circadiano natural.</string>
    <string name="hu20_rec15_tag">Horarios</string>

