<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_monitoreo_root">

    <!-- Ambient Orbital Aura Blobs -->
    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="20dp"
        android:alpha="0.12"
        android:background="@drawable/bg_moon_circle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">

            <!-- Top Header Navigation & Status Pill -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hu05_volver"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="-12dp"
                    android:text="Volver"
                    android:textColor="@color/primary"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconTint="@color/primary"
                    app:rippleColor="@color/primary_subtle" />

                <!-- Status Badge Pill (Centered) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ll_hu05_badge_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    app:cardBackgroundColor="@color/chip_bg"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/v_hu05_badge_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_moon_circle"
                            android:backgroundTint="@color/text_muted" />

                        <TextView
                            android:id="@+id/tv_hu05_badge_texto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="En espera"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tv_hu05_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Monitoreo de descanso"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Central Celestial Moon Avatar with Pulse -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp">

                <!-- Soft Glow Halo -->
                <View
                    android:id="@+id/v_hu05_glow_halo"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:alpha="0.22"
                    android:background="@drawable/bg_moon_circle"
                    android:backgroundTint="@color/primary" />

                <!-- Lens Circle Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="60dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/primary_subtle"
                    app:cardElevation="10dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/primary"
                        tools:ignore="ContentDescription" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Time Metrics Display -->
            <TextView
                android:id="@+id/tv_hu05_lbl_inicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Hora actual"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tv_hu05_reloj_grande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="23:14"
                android:textColor="@color/text_primary"
                android:textSize="60sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Card: Horas Transcurridas en Vivo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/primary_subtle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIEMPO DE SUEÑO TRANSCURRIDO"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tv_hu05_tiempo_transcurrido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="00h 00m 00s"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_hu05_estado_subtexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Presiona iniciar para comenzar a medir tu descanso"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Telemetry Cards -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <!-- Sensor 1: Acelerómetro -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📡"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="Movimiento (Acelerómetro)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_hu05_sensor_accel_estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_mint"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Listo"
                            android:textColor="@color/accent_mint"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/divider" />

                    <!-- Sensor 2: Eventos de pantalla -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="Interacciones nocturnas"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_hu05_sensor_pantalla_estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_mint"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="0 eventos"
                            android:textColor="@color/accent_mint"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/divider" />

                    <!-- Sensor 3: Privacidad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="Privacidad y almacenamiento"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_indigo"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="100% Local"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tip Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Deja tu smartphone en tu velador o cerca de tu cama para medir tu descanso con precisión"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Main Dynamic Toggle Button (Iniciar / Finalizar) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hu05_accion"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="🌙  Iniciar monitoreo"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="18dp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
